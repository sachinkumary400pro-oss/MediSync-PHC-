# MediSync PHC Environment Configuration

# Project & API Metadata
PROJECT_NAME="MediSync PHC"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# JWT Security
# Generate a secure 64-character hex key in production: `openssl rand -hex 32`
SECRET_KEY="medisync-tamilnadu-secure-production-jwt-key-change-in-prod"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Connection
# SQLite (Local Development):
DATABASE_URL="sqlite:///./data/medisync_fastapi.db"
# PostgreSQL (Production / Docker):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/medisync"

# Notification Services (SMS / WhatsApp)
ENABLE_SMS_MOCK=True
ENABLE_WHATSAPP_MOCK=True

# Optional External AI API Key (Fallback to local built-in forecasting & NLP heuristics if omitted)
OPENAI_API_KEY=""
